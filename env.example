# Copy to .env and adjust as needed.

# Postgres (used by packages/db and apps/api, and by docker-compose to set up the
# container - keep these three in sync with the credentials embedded in DATABASE_URL below)
POSTGRES_USER=climbing
POSTGRES_PASSWORD=climbing
POSTGRES_DB=climbing_logbook
DATABASE_URL=postgres://climbing:climbing@localhost:5432/climbing_logbook

# apps/api
API_PORT=8787
# Vestigial: apps/web (SvelteKit) always talks to apps/api same-origin via
# Vite's dev-server proxy (see apps/web/vite.config.ts), so the CORS
# middleware keyed on this value is dead-but-harmless in practice. Kept
# around in case that ever changes.
WEB_ORIGIN=http://localhost:5173
UPLOADS_DIR=./uploads

# MinIO (started via docker-compose, not yet wired into apps/api - local disk
# storage is used for v1, see apps/api/src/lib/storage.ts)
MINIO_ROOT_USER=climbing
MINIO_ROOT_PASSWORD=climbing-dev-secret

# apps/web (SvelteKit, vite dev on :5173) - not currently read: apps/web always
# calls the API same-origin via relative paths (/health, /api/...), proxied to
# apps/api by apps/web/vite.config.ts in dev. Kept here as a placeholder for
# when/if an absolute API URL is needed.
VITE_API_URL=http://localhost:8787
